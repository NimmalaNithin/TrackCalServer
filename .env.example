spring.mongodb.uri=mongodb://localhost:27017/trackcal
jwt.secret=replace-with-a-long-random-production-secret
jwt.expiration=86400000
app.cors.allowed-origins=http://localhost:5173,http://127.0.0.1:5173
google.client-id=replace-with-google-oauth-client-id
google.client-secret=replace-with-google-oauth-client-secret
google.redirect-uri=http://localhost:8080/api/auth/google/callback
app.frontend-url=http://localhost:5173
