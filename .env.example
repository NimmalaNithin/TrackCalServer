SPRING_MONGODB_URI=mongodb://localhost:27017/trackcal
JWT_SECRET=replace-with-a-long-random-production-secret
APP_CORS_ALLOWED_ORIGINS=https://your-vercel-app.vercel.app
APP_FRONTEND_URL=https://your-vercel-app.vercel.app
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://your-render-service.onrender.com/api/auth/google/callback

# Use smtp locally if Gmail SMTP is available.
APP_EMAIL_PROVIDER=smtp
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-email-app-password

# Use resend in production on hosts that block SMTP ports.
# APP_EMAIL_PROVIDER=resend
# RESEND_API_KEY=replace-with-resend-api-key
# MAIL_FROM=Track Cal <onboarding@resend.dev>

# Use brevo in production with a verified Brevo sender.
# APP_EMAIL_PROVIDER=brevo
# BREVO_API_KEY=replace-with-brevo-api-key
# BREVO_MAIL_FROM_EMAIL=your-verified-sender@example.com
# BREVO_MAIL_FROM_NAME=Track Cal
